          <geometry><cylinder><radius>0.013</radius><length>4.122455</length></cylinder></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>

        <collision name="cable_13_collision">
          <pose>26.0 0 0.021 1.57079632679 0 0.104719755</pose>
          <geometry><cylinder><radius>0.021</radius><length>4.022033</length></cylinder></geometry>
