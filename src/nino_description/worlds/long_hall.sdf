          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="cable_07_visual">
          <pose>12.0 0 0.009 1.57079632679 0 0.174532925</pose>
          <geometry><cylinder><radius>0.009</radius><length>4.061706</length></cylinder></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>

        <collision name="cable_08_collision">
          <pose>14.5 0 0.022 1.57079632679 0 -0.349065850</pose>
          <geometry><cylinder><radius>0.022</radius><length>4.256711</length></cylinder></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="cable_08_visual">
          <pose>14.5 0 0.022 1.57079632679 0 -0.349065850</pose>
          <geometry><cylinder><radius>0.022</radius><length>4.256711</length></cylinder></geometry>
          <material><ambient>0.42 0.15 0.02 1</ambient><diffuse>0.92 0.32 0.04 1</diffuse></material>
        </visual>

        <collision name="cable_09_collision">
          <pose>17.0 0 0.015 1.57079632679 0 0.244346095</pose>
          <geometry><cylinder><radius>0.015</radius><length>4.122455</length></cylinder></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="cable_09_visual">
          <pose>17.0 0 0.015 1.57079632679 0 0.244346095</pose>
