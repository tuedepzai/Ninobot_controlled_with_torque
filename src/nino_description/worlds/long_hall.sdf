          <material><ambient>0.42 0.15 0.02 1</ambient><diffuse>0.92 0.32 0.04 1</diffuse></material>
        </visual>

        <collision name="cable_05_collision">
          <pose>8.0 0 0.012 1.57079632679 0 0.383972435</pose>
          <geometry><cylinder><radius>0.012</radius><length>4.314139</length></cylinder></geometry>
