          <geometry><cylinder><radius>0.012</radius><length>4.314139</length></cylinder></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>

        <collision name="cable_06_collision">
          <pose>10.0 0 0.018 1.57079632679 0 -0.279252680</pose>
          <geometry><cylinder><radius>0.018</radius><length>4.161198</length></cylinder></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="cable_06_visual">
