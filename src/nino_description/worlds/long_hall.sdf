<?xml version="1.0"?>
<sdf version="1.9">
  <world name="long_hall">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.80665</gravity>
    <scene>
      <ambient>0.28 0.28 0.30 1</ambient>
      <background>0.08 0.09 0.12 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Interior lamps keep the closed hall evenly lit. -->
    <light name="lamp_01" type="point">
      <pose>2 0 2.7 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.95 0.92 0.84 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation><range>11</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="lamp_02" type="point">
      <pose>10 0 2.7 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.95 0.92 0.84 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation><range>11</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="lamp_03" type="point">
      <pose>18 0 2.7 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.95 0.92 0.84 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation><range>11</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="lamp_04" type="point">
      <pose>26 0 2.7 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.95 0.92 0.84 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation><range>11</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!--
      Closed hall dimensions:
        inside X: -2.0 m to 32.0 m (34 m long)
        inside Y: -2.0 m to  2.0 m (4 m clear width)
        inside Z:  0.0 m to  3.0 m
      The side-wall centres are at Y +/-2.1 with 0.2 m thickness, so their
      inside faces are exactly Y +/-2.0.
    -->
    <model name="enclosed_hall">
      <static>true</static>
      <link name="structure">
        <collision name="floor_collision">
          <pose>15 0 -0.05 0 0 0</pose>
          <geometry><box><size>34 4 0.1</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="floor_visual">
          <pose>15 0 -0.05 0 0 0</pose>
          <geometry><box><size>34 4 0.1</size></box></geometry>
          <material>
            <ambient>0.32 0.34 0.37 1</ambient>
            <diffuse>0.42 0.44 0.47 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>

        <collision name="left_wall_collision">
          <pose>15 2.1 1.5 0 0 0</pose>
          <geometry><box><size>34.4 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="left_wall_visual">
          <pose>15 2.1 1.5 0 0 0</pose>
          <geometry><box><size>34.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.52 0.55 0.60 1</ambient><diffuse>0.62 0.65 0.70 1</diffuse></material>
        </visual>

        <collision name="right_wall_collision">
          <pose>15 -2.1 1.5 0 0 0</pose>
          <geometry><box><size>34.4 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="right_wall_visual">
          <pose>15 -2.1 1.5 0 0 0</pose>
          <geometry><box><size>34.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.52 0.55 0.60 1</ambient><diffuse>0.62 0.65 0.70 1</diffuse></material>
        </visual>

        <collision name="rear_wall_collision">
          <pose>-2.1 0 1.5 0 0 0</pose>
          <geometry><box><size>0.2 4.4 3.0</size></box></geometry>
        </collision>
        <visual name="rear_wall_visual">
          <pose>-2.1 0 1.5 0 0 0</pose>
          <geometry><box><size>0.2 4.4 3.0</size></box></geometry>
          <material><ambient>0.40 0.43 0.48 1</ambient><diffuse>0.50 0.53 0.58 1</diffuse></material>
        </visual>

        <collision name="front_wall_collision">
          <pose>32.1 0 1.5 0 0 0</pose>
          <geometry><box><size>0.2 4.4 3.0</size></box></geometry>
        </collision>
        <visual name="front_wall_visual">
          <pose>32.1 0 1.5 0 0 0</pose>
          <geometry><box><size>0.2 4.4 3.0</size></box></geometry>
          <material><ambient>0.40 0.43 0.48 1</ambient><diffuse>0.50 0.53 0.58 1</diffuse></material>
        </visual>

        <collision name="ceiling_collision">
          <pose>15 0 3.05 0 0 0</pose>
          <geometry><box><size>34 4 0.1</size></box></geometry>
        </collision>
        <visual name="ceiling_visual">
          <pose>15 0 3.05 0 0 0</pose>
          <geometry><box><size>34 4 0.1</size></box></geometry>
          <transparency>0.70</transparency>
          <cast_shadows>false</cast_shadows>
          <material><ambient>0.45 0.47 0.52 1</ambient><diffuse>0.55 0.57 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      The cables vary from 16 mm to 44 mm in diameter and cross the driving
      line at angles from -22 to +24 degrees.  For an angle A, cylinder length
      is 4.0 / cos(A), so its Y projection is always exactly the hall's 4.0 m
      clear width (Y=-2.0 to Y=+2.0). Centres sit one radius above the floor.
    -->
    <model name="cable_bumps">
      <static>true</static>
      <link name="cables">
        <collision name="cable_01_collision">
          <pose>1.5 0 0.008 1.57079632679 0 0.139626340</pose>
          <geometry><cylinder><radius>0.008</radius><length>4.039310</length></cylinder></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="cable_01_visual">
          <pose>1.5 0 0.008 1.57079632679 0 0.139626340</pose>
          <geometry><cylinder><radius>0.008</radius><length>4.039310</length></cylinder></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>

        <collision name="cable_02_collision">
          <pose>3.0 0 0.014 1.57079632679 0 -0.209439510</pose>
          <geometry><cylinder><radius>0.014</radius><length>4.089362</length></cylinder></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="cable_02_visual">
          <pose>3.0 0 0.014 1.57079632679 0 -0.209439510</pose>
          <geometry><cylinder><radius>0.014</radius><length>4.089362</length></cylinder></geometry>
          <material><ambient>0.42 0.15 0.02 1</ambient><diffuse>0.92 0.32 0.04 1</diffuse></material>
        </visual>

        <collision name="cable_03_collision">
          <pose>4.5 0 0.010 1.57079632679 0 0.314159265</pose>
          <geometry><cylinder><radius>0.010</radius><length>4.205849</length></cylinder></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="cable_03_visual">
          <pose>4.5 0 0.010 1.57079632679 0 0.314159265</pose>
          <geometry><cylinder><radius>0.010</radius><length>4.205849</length></cylinder></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>

        <collision name="cable_04_collision">
          <pose>6.5 0 0.020 1.57079632679 0 -0.104719755</pose>
          <geometry><cylinder><radius>0.020</radius><length>4.022033</length></cylinder></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="cable_04_visual">
          <pose>6.5 0 0.020 1.57079632679 0 -0.104719755</pose>
