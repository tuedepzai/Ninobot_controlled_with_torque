#!/usr/bin/env python3
"""Run Gazebo Sim and turn an intentional launch interrupt into a clean exit."""

import os
import signal
import subprocess
import sys


child = None
shutdown_requested = False


def request_shutdown(_signum=None, _frame=None) -> None:
    """Record the interrupt, including interrupts during child creation."""
    global shutdown_requested
    shutdown_requested = True


def stop_child() -> None:
    """Stop and reap the child before the launch wrapper exits."""
    if child is None or child.poll() is not None:
        return
    try:
        subprocess.run(
            [
                "gz",
                "service",
                "-s",
                "/server_control",
                "--reqtype",
                "gz.msgs.ServerControl",
                "--reptype",
                "gz.msgs.Boolean",
                "--timeout",
                "1000",
                "--req",
                "stop: true",
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2.0,
        )
    except (OSError, subprocess.SubprocessError):
        pass

    if child is not None and child.poll() is None:
        try:
            child.wait(timeout=0.5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(child.pid, signal.SIGTERM)
                child.wait(timeout=1.0)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGKILL)
                child.wait()
            except ProcessLookupError:
                pass


def main() -> int:
    global child

    signal.signal(signal.SIGINT, request_shutdown)
    signal.signal(signal.SIGTERM, request_shutdown)

    # Empty arguments can come from conditional launch substitutions.
    gazebo_arguments = [argument for argument in sys.argv[1:] if argument]
    if shutdown_requested:
        return 0
    child = subprocess.Popen(
        ["gz", "sim", *gazebo_arguments],
        start_new_session=True,
    )
    # A signal can arrive between Popen starting Gazebo and assigning child.
    # Handle it here after assignment, so a launch exception cannot leave an
    # orphaned server publishing an unrelated simulation clock.
    try:
        while not shutdown_requested:
            try:
                return child.wait(timeout=0.1)
            except subprocess.TimeoutExpired:
                pass
    finally:
        stop_child()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
